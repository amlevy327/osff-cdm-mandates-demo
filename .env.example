# Copy to .env and fill in. Only needed to deploy your own copy: tracing our demo needs no .env.
# Never commit .env, and never paste either value into a chat, an issue or a log.
# Check it with:  make check-env DEPLOYMENT=mine   (prints only pass or a plain error)

# A Sepolia RPC endpoint as a FULL URL, not a bare API key. For example:
#   https://sepolia.infura.io/v3/<key>
#   https://eth-sepolia.g.alchemy.com/v2/<key>
#   https://ethereum-sepolia-rpc.publicnode.com   (public, no key, used when this is empty)
SEPOLIA_RPC_URL=""

# A NEW mnemonic used only for this demo. Create one in your own terminal: cast wallet new-mnemonic
# Put all 12 words inside the quotes, separated by single spaces.
# Actors are derived from it by index:
#   0 issuer (fund this one from a Sepolia faucet, ~0.1 ETH), 1 registrar, 2 calculation agent,
#   3 paying agent, 4-6 holders (never sign)
MNEMONIC=""

# Optional
# EAS=""                # only for chains other than Sepolia
# SCHEMA_REGISTRY=""    # only for chains other than Sepolia
# EXPLORER_URL=""       # default https://sepolia.etherscan.io
# EASSCAN_URL=""        # default https://sepolia.easscan.org
